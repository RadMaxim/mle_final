FROM python:3.10-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    mlflow==3.15.1 \
    psycopg2-binary \
    boto3
    
COPY mlflow_req.txt /app/mlflow_req.txt

RUN pip install --no-cache-dir \
    -r /app/mlflow_req.txt

COPY server_model.sh /app/server_model.sh

RUN chmod +x /app/server_model.sh

CMD ["/app/server_model.sh"]